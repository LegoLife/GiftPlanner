@inherits LayoutComponentBase
@using GiftPlanner.Auth

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIcon Icon="@Icons.Material.Filled.Redeem" Class="mr-3" />
        <MudText Typo="Typo.h6" Class="d-none d-sm-flex">Gift Planner</MudText>
        <MudSpacer />
        <AuthorizeView Roles="@Roles.Admin">
            <MudButton Href="/" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.ListAlt">Gifts</MudButton>
            <MudButton Href="setup" Color="Color.Inherit" StartIcon="@Icons.Material.Filled.Groups">People</MudButton>
        </AuthorizeView>
        <MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleDarkAsync" aria-label="Toggle dark mode" />
        </MudTooltip>
        <AuthorizeView>
            <form method="post" action="logout" data-enhance="false">
                <AntiforgeryToken />
                <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit" aria-label="Sign out" />
            </form>
        </AuthorizeView>
    </MudAppBar>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private MudThemeProvider _themeProvider = default!;
    private bool _dark;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#b3261e",
            Secondary = "#1e6b3a",
            AppbarBackground = "#b3261e",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#f08a80",
            Secondary = "#7fc79a",
            AppbarBackground = "#5c1410",
            Background = "#1b1a1a",
            Surface = "#252323",
            DrawerBackground = "#252323",
        },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var saved = await JS.InvokeAsync<string?>("gpTheme.get");
        _dark = saved is null ? await _themeProvider.GetSystemDarkModeAsync() : saved == "dark";
        StateHasChanged();
    }

    private async Task ToggleDarkAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("gpTheme.set", _dark ? "dark" : "light");
    }
}
