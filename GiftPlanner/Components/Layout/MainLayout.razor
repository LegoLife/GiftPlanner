@inherits LayoutComponentBase
@using GiftPlanner.Auth

<MudThemeProvider @ref="_themeProvider" Theme="_theme" IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="gp-shell">
    <MudAppBar Elevation="0" Class="gp-appbar">
        <a href="" class="gp-brand">
            <img src="favicon.svg" alt="" width="28" height="28" />
            <span class="d-none d-sm-inline">Gift<em>Planner</em></span>
        </a>
        <MudSpacer />
        <AuthorizeView Roles="@Roles.Admin">
            <nav class="gp-nav">
                <NavLink href="" Match="NavLinkMatch.All">Gifts</NavLink>
                <NavLink href="setup">People</NavLink>
                <NavLink href="import">Import</NavLink>
            </nav>
        </AuthorizeView>
        <MudTooltip Text="@(_dark ? "Light mode" : "Dark mode")">
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleDarkAsync" aria-label="Toggle dark mode" />
        </MudTooltip>
        @if (OperatingSystem.IsBrowser())
        {
            <a class="gp-demo-tag" href="g/grandma-grandpa" title="Open the page Grandma &amp; Grandpa's share link shows">Giver view</a>
        }
        else
        {
        <AuthorizeView>
            <form method="post" action="logout" data-enhance="false">
                <AntiforgeryToken />
                <MudIconButton ButtonType="ButtonType.Submit" Icon="@Icons.Material.Filled.Logout"
                               Color="Color.Inherit" aria-label="Sign out" />
            </form>
        </AuthorizeView>
        }
    </MudAppBar>
    @if (OperatingSystem.IsBrowser())
    {
        <div class="gp-demo-banner">
            Demo: everything runs in your browser with made-up data and resets when you reload.
            Reading product details from store links is turned off.
        </div>
    }
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-8 gp-main">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private MudThemeProvider _themeProvider = default!;
    private bool _dark;

    private static readonly string[] Sans = ["Inter", "system-ui", "-apple-system", "Segoe UI", "sans-serif"];
    private static readonly string[] Serif = Sans;

    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#a3201b",
            Secondary = "#1f5c3d",
            Success = "#1f7a4d",
            Background = "#eaeded",
            Surface = "#ffffff",
            AppbarBackground = "#131921",
            AppbarText = "#ffffff",
            TextPrimary = "#0f1111",
            TextSecondary = "#565959",
            LinesDefault = "#d5d9d9",
            TableLines = "#e3e6e6",
            BackgroundGray = "#f7f8f8",
            ActionDefault = "#6b625a",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#e2584c",
            Secondary = "#86d1a4",
            Success = "#86d1a4",
            Background = "#181a1a",
            Surface = "#222525",
            DrawerBackground = "#222525",
            AppbarBackground = "#0f1111",
            AppbarText = "#f3ece5",
            TextPrimary = "#f3ece5",
            TextSecondary = "#a89d94",
            LinesDefault = "#2f2926",
            TableLines = "#2a2522",
            BackgroundGray = "#262120",
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "14px" },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = Sans },
            H3 = new H3Typography { FontFamily = Serif, FontWeight = "500", LetterSpacing = "-.02em" },
            H4 = new H4Typography { FontFamily = Serif, FontWeight = "500", LetterSpacing = "-.02em" },
            H5 = new H5Typography { FontFamily = Serif, FontWeight = "500", LetterSpacing = "-.01em" },
            H6 = new H6Typography { FontFamily = Serif, FontWeight = "500" },
            Button = new ButtonTypography { FontFamily = Sans, FontWeight = "600", TextTransform = "none", LetterSpacing = "0" },
        },
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        var saved = await JS.InvokeAsync<string?>("gpTheme.get");
        _dark = saved is null ? await _themeProvider.GetSystemDarkModeAsync() : saved == "dark";
        StateHasChanged();
    }

    private async Task ToggleDarkAsync()
    {
        _dark = !_dark;
        await JS.InvokeVoidAsync("gpTheme.set", _dark ? "dark" : "light");
    }
}
