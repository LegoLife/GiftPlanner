<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" />
    <link rel="stylesheet" href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["GiftPlanner.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>
    <script>
        window.gpTheme = {
            get: () => { try { return localStorage.getItem("gp.theme"); } catch { return null; } },
            set: v => { try { localStorage.setItem("gp.theme", v); } catch { } }
        };
        window.gpCopy = async text => {
            try { await navigator.clipboard.writeText(text); return true; } catch { }
            // Fallback for plain-HTTP LAN addresses, where the clipboard API is blocked.
            try {
                const t = document.createElement("textarea");
                t.value = text; t.style.position = "fixed"; t.style.opacity = "0";
                document.body.appendChild(t); t.select();
                const ok = document.execCommand("copy"); t.remove(); return ok;
            } catch { return false; }
        };
    </script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // The login page must be static SSR (it sets a cookie); everything else is Interactive Server.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
