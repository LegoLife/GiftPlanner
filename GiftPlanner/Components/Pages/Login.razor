@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@attribute [ExcludeFromInteractiveRouting]
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using GiftPlanner.Auth
@inject AccountService Accounts
@inject SignupGuard Guard
@inject SignInOptions Options
@inject NavigationManager Nav

<PageTitle>Sign in · Gift Planner</PageTitle>

<div class="login-card">
    <img src="favicon.svg" alt="" width="44" height="44" />
    <h1>Gift<em>Planner</em></h1>
    <p class="login-sub">The family wish list, kept quiet till Christmas.</p>

    @if (Options.GoogleEnabled)
    {
        <a class="google-btn" href="@($"auth/google?returnUrl={Uri.EscapeDataString(SignInOptions.SafeReturnUrl(ReturnUrl))}")">
            <GoogleMark /> Continue with Google
        </a>
        <div class="login-or"><span>or</span></div>
    }
    @if (Error == "google")
    {
        <p class="login-error" role="alert">Google sign-in didn't finish. Please try again.</p>
    }

    <form class="login-form" method="post" @onsubmit="SignInAsync" @formname="login">
        <AntiforgeryToken />
        <label for="email">Email</label>
        <input id="email" name="Email" type="email" autocomplete="username" required value="@Email" />
        <label for="password">Password</label>
        <input id="password" name="Password" type="password" autocomplete="current-password" required value="" />
        @if (_message is not null)
        {
            <p class="login-error" role="alert">@_message</p>
        }
        <button type="submit">Sign in</button>
    </form>

    <p class="login-alt">New here? <a href="@($"signup?ReturnUrl={Uri.EscapeDataString(SignInOptions.SafeReturnUrl(ReturnUrl))}")">Create an account</a></p>
</div>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;
    [SupplyParameterFromForm] private string? Email { get; set; }
    [SupplyParameterFromForm] private string? Password { get; set; }
    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery] private string? Error { get; set; }

    private string? _message;

    private async Task SignInAsync()
    {
        if (!Guard.AllowLoginAttempt(HttpContext.Connection.RemoteIpAddress?.ToString() ?? "?"))
        {
            _message = "Too many tries. Please wait a few minutes.";
            return;
        }
        var account = await Accounts.VerifyPasswordAsync(Email, Password);
        if (account is null)
        {
            await Task.Delay(1000); // slow down guessing
            _message = "That email and password don't match.";
            return;
        }

        await HttpContext.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme,
            AccountService.Principal(account), new AuthenticationProperties { IsPersistent = true });
        Nav.NavigateTo(SignInOptions.SafeReturnUrl(ReturnUrl), forceLoad: true);
    }
}
